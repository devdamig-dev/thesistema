{
  "name": "gastropilot-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "rm -rf .test-dist && tsc -p tests/tsconfig.json && node --test .test-dist/tests/*.test.js",
    "test:db:stock": "node scripts/run-catalog-sql.mjs stock-ledger",
    "test:db:catalog": "node scripts/run-catalog-sql.mjs",
    "test:ui:catalog": "node scripts/run-catalog-ui.mjs",
    "test:customers:sql": "node scripts/run-customers-sql.mjs",
    "test:suppliers:sql": "node scripts/run-suppliers-sql.mjs",
    "test:debts:sql": "node scripts/run-debt-plans-sql.mjs",
    "test:debts:concurrency": "node scripts/run-debt-plans-sql.mjs --native-concurrency",
    "test:ui:customers": "node scripts/run-customers-ui.mjs",
    "test:ui:suppliers": "node scripts/run-suppliers-ui.mjs",
    "test:ui:stock": "node scripts/run-stock-ui.mjs",
    "test:ui:debts": "node tests/debt-plan-ui.browser.mjs",
    "test:ui:inbox-debts": "node tests/inbox-debt-ui.browser.mjs",
    "test:ui": "node scripts/run-management-ui.mjs",
    "test:ui:bundle": "BUNDLE_ONLY=1 npm run test:ui",
    "test:ui:fixtures": "node --test tests/management-ui-fixtures.test.mjs",
    "test:db:native": "node scripts/run-catalog-sql.mjs --native-docker && node scripts/run-catalog-sql.mjs stock-ledger --native-docker && node scripts/run-customers-sql.mjs --native-docker && node scripts/run-suppliers-sql.mjs --native-docker && node scripts/run-debt-plans-sql.mjs --native-docker"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.9",
    "lucide-react": "^0.453.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^2.13.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^20.16.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "playwright": "1.64.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.2"
  }
}
